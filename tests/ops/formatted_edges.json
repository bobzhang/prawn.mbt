{
  "ops": [
    ["formatted_text", [
      { "text": "Times-Bold named ", "font": "Times-Bold" },
      { "text": "Courier-Oblique with bold ", "font": "Courier-Oblique", "styles": [":bold"] },
      { "text": "red underline", "color": "FF0000", "styles": [":underline"] }
    ]],
    ["stroke_color", "0000FF"],
    ["formatted_text", [{ "text": "blue-stroked underline ", "styles": [":underline"] }, { "text": "green struck", "color": "00AA00", "styles": [":strikethrough"] }]],
    ["formatted_text", [{ "text": "both link and anchor", "link": "https://example.com", "anchor": "dest" }]],
    ["text", "<link href='u'>x<a anchor='d'>y</a></link> <b><b>bold</b>plain</b> <sup><sub>sub wins</sub></sup> line<br\n/>break", { "inline_format": true }],
    ["!raises", "ArgumentError", ["text", "<font size='oops'>x</font>", { "inline_format": true }]],
    ["!raises", "Prawn::Errors::IncompatibleStringEncoding", ["formatted_text", [{ "text": "W" }, { "text": "中" }], { "size": 200 }]],
    ["?cursor"]
  ]
}
