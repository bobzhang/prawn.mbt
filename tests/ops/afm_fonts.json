{
  "ops": [
    ["?font.inspect"],
    ["font", "Times-Roman", { "style": ":bold" }],
    ["text", "Times bold"],
    ["?font.inspect"],
    ["font", "Courier", { "size": 9, "block": [["text", "Courier nine inside"], ["?font.inspect"], ["?font_size"]] }],
    ["text", "Times bold again, at its size"],
    ["font", "Helvetica-Oblique"],
    ["text", "a face by its own name"],
    ["?font.inspect"],
    ["font", "Helvetica"],
    ["formatted_text", [{ "text": "a callback sets a face by name", "callback": { "trace": "f", "phase": "in_front", "draw": [["font", "Times-Bold"]] } }]],
    ["text", "italic after the callback", { "style": ":italic" }],
    ["?font_size", 16],
    ["text", "sixteen"],
    ["?font_size", 8, { "block": [["text", "eight inside"]] }],
    ["?font_size"],
    ["?font_size=", 12],
    ["text", "plain, then <i>italic</i> with the style option", { "style": ":bold", "inline_format": true }],
    ["formatted_text", [{ "text": "a fragment of no style " }, { "text": "and an italic one", "styles": [":italic"] }], { "style": ":bold" }],
    ["?text_box", "a bold italic text box", { "at": [300.0, 300.0], "width": 120.0, "height": 60.0, "style": ":bold_italic" }],
    ["?width_of", "AVATAR", { "style": ":bold" }],
    ["?height_of", "a bold height of text long enough to wrap onto a second line in the bounds of the page", { "style": ":bold", "size": 20.0 }],
    ["!raises", "Prawn::Errors::UnknownFont", ["font", "No-Such-Font"]],
    ["text", "after the unknown font"],
    ["?font"],
    ["?font", "Courier"],
    ["font", "Times-Bold"],
    ["!raises", "PDF::Core::Text::BadFontFamily", ["text", "x", { "style": ":italic" }]],
    ["!raises", "PDF::Core::Text::BadFontFamily", ["?text_box", "x", { "style": ":italic" }]],
    ["!raises", "PDF::Core::Text::BadFontFamily", ["?height_of", "x", { "style": ":italic" }]],
    ["!raises", "Prawn::Errors::UnknownFont", ["?width_of", "x", { "style": ":italic" }]],
    ["!raises", "Prawn::Text::Formatted::Arranger::BadFontFamily", ["formatted_text", [{ "text": "x", "styles": [":bold"] }]]],
    ["!raises", "Prawn::Text::Formatted::Arranger::BadFontFamily", ["formatted_text", [{ "text": "x", "font": "Courier" }]]],
    ["text", "plain in Times-Bold"],
    ["font", "Helvetica"],
    ["?cursor"]
  ]
}
